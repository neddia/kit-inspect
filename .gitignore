# Python environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Images are too big for Git history (plan: LFS or a release download)
data/images/

# Model weights and exports: download or rebuild, don't commit
models/*
!models/.gitkeep
*.pt
*.ts
*.onnx

# Ultralytics writes run folders here by default
runs/

# Bulk run output: regenerate with the scripts (curate a few for the report later)
reports/**/wrong/
reports/explore/

# Derived YOLO training layout (rebuilt by src/labeling/export_yolo.py)
data/yolo/
